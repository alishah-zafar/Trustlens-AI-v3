# AI Configuration — set ONE of these for voice transcription
# Option 1: Google Gemini (recommended for audio transcription)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-flash

# Option 2: OpenAI Whisper (fallback for audio, also used for text analysis)
# Supports any OpenAI-compatible API (OpenAI, Groq, Together, local Ollama, etc.)
OPENAI_API_KEY=your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Server
PORT=3001
CORS_ORIGIN=https://trustlens-ai-five.vercel.app/
